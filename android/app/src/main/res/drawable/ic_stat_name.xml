<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification Icon: Tilted milk glass with droplets
  White flat icon on transparent background for Android notification bar.
  24dp x 24dp, viewportWidth=24, viewportHeight=24
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!--
        Tilted glass body: a trapezoid rotated ~-15deg
        Glass is slightly wider at the top, narrower at the bottom.
        Tilted to the right using a rotated path.
    -->

    <!-- Glass outline (slightly tilted trapezoid — glass body) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
          M 5.5,4.5
          L 11.5,3.0
          L 14.5,18.5
          L 8.5,20.0
          Z
        " />

    <!-- Glass rim (top edge highlight rectangle) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
          M 5.0,4.0
          L 12.2,2.2
          L 12.8,4.2
          L 5.6,6.0
          Z
        " />

    <!-- Droplet 1 — larger, top right of spill -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
          M 15.5,9.0
          C 15.5,7.8 17.0,7.0 17.5,8.5
          C 18.0,10.0 16.5,10.8 15.5,9.0
          Z
        " />

    <!-- Droplet 2 — medium, mid right -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
          M 17.0,13.5
          C 17.0,12.5 18.2,12.0 18.5,13.2
          C 18.8,14.4 17.5,15.0 17.0,13.5
          Z
        " />

    <!-- Droplet 3 — small, lower right -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
          M 16.0,17.0
          C 16.0,16.2 17.0,15.8 17.2,16.8
          C 17.4,17.8 16.2,18.2 16.0,17.0
          Z
        " />

</vector>
