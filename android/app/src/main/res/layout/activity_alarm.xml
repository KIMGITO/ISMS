<?xml version="1.0" encoding="utf-8"?>
<!-- The alarm screen shown over the lock screen when a reminder rings. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/alarm_background"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="20dp"
    android:paddingEnd="28dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_stat_denso"
            android:tint="#FFF59E0B" />

        <TextView
            android:id="@+id/alarm_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:text="DENSO"
            android:textColor="#FFF59E0B"
            android:textSize="13sp" />
    </LinearLayout>

    <TextClock
        android:id="@+id/alarm_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="sans-serif-light"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:textColor="#FFFFFBF2"
        android:textSize="84sp" />

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:format12Hour="EEEE, d MMMM"
        android:format24Hour="EEEE, d MMMM"
        android:textColor="#B3FFFBF2"
        android:textSize="16sp" />

    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/alarm_art"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_denso_large" />

    <TextView
        android:id="@+id/alarm_kind"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.15"
        android:text="REMINDER"
        android:textColor="#FFFBBF24"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/alarm_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="#FFFFFFFF"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/alarm_notes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:maxLines="4"
        android:ellipsize="end"
        android:textColor="#CCFFFBF2"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/alarm_set_for"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/alarm_time_pill"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:textColor="#FFFDE68A"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/alarm_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#99FFFBF2"
        android:textSize="14sp"
        android:visibility="gone" />

    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/alarm_accept"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/alarm_accept_button"
        android:fontFamily="sans-serif-medium"
        android:stateListAnimator="@null"
        android:text="Accept"
        android:textAllCaps="false"
        android:textColor="#FF451A03"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/alarm_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Stops the alarm and opens Denso"
        android:textColor="#80FFFBF2"
        android:textSize="13sp" />
</LinearLayout>
