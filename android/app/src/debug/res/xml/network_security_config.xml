<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow plain HTTP for the emulator host (10.0.2.2) and
     Capacitor live reload from a dev machine on the local network. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
