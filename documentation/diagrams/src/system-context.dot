// Figure 2.1: System context. Who uses ISMS and which external systems it exchanges data with.
digraph context {
  graph [rankdir=LR, fontname="Arial", fontsize=11, nodesep=0.35, ranksep=0.9, pad=0.2, bgcolor="white"];
  node  [fontname="Arial", fontsize=10, shape=box, style="rounded,filled", fillcolor="#f8fafc", color="#475569", penwidth=1.1];
  edge  [fontname="Arial", fontsize=8.5, color="#64748b", arrowsize=0.7];

  subgraph cluster_people {
    label="People"; style="rounded,dashed"; color="#94a3b8"; fontcolor="#334155";
    staff    [label="Staff\n(Owner, Admin, Manager,\nCashier, Rider)", shape=box, fillcolor="#fff7ed"];
    webcust  [label="Customer\n(smartphone or PC)", fillcolor="#fff7ed"];
    phonecust[label="Customer\n(basic phone)", fillcolor="#fff7ed"];
  }

  subgraph cluster_isms {
    label="ISMS (KayKay's)"; style="rounded,filled"; fillcolor="#fffbeb"; color="#b45309"; fontcolor="#7c2d12"; penwidth=1.4;
    app     [label="Staff app\nAndroid · Windows · Linux · browser"];
    site    [label="Customer website\n(static web build)"];
    backend [label="Supabase backend\nPostgreSQL · Auth · Storage ·\nRealtime · Edge Functions · pg_cron", fillcolor="#fef3c7", color="#b45309"];
  }

  subgraph cluster_ext {
    label="External systems"; style="rounded,dashed"; color="#94a3b8"; fontcolor="#334155";
    daraja  [label="Safaricom Daraja\n(M-Pesa STK push, C2B)"];
    at      [label="Africa's Talking\n(USSD gateway)"];
    fcm     [label="Firebase Cloud\nMessaging"];
    msg     [label="Twilio SMS ·\nWhatsApp Cloud API"];
    mail    [label="Email\n(Resend / SendGrid / SMTP)"];
    ai      [label="AI providers\n(Hugging Face, Gemini, OpenAI,\nAnthropic, DeepSeek, Groq, OpenRouter)"];
    sheets  [label="Google Sheets\n(backup export)"];
    kra     [label="KRA eTIMS (OSCU)"];
    gh      [label="GitHub Releases\n(installers, latest.json)"];
  }

  staff -> app;
  webcust -> site;
  phonecust -> at [label="dials USSD code"];
  app -> backend [label="HTTPS · JWT\nsupabase-js"];
  site -> backend [label="HTTPS · JWT\nsupabase-js"];
  at -> backend [label="callback\n(token in URL)"];
  backend -> daraja [label="STK push,\nC2B registration"];
  daraja -> backend [label="payment callbacks\n(token in URL)", style=dashed];
  backend -> fcm [label="push"];
  backend -> msg;
  backend -> mail;
  backend -> ai [label="prompts"];
  backend -> sheets [label="scheduled export"];
  backend -> kra [label="sign sale"];
  gh -> app [label="update check\nand download", style=dashed];
}
