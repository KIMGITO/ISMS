// Figure 20.2: Release pipeline in .github/workflows/release-and-deploy.yml.
digraph release {
  graph [rankdir=LR, fontname="Arial", fontsize=11, nodesep=0.3, ranksep=0.45, pad=0.2];
  node  [fontname="Arial", fontsize=9, shape=box, style="rounded,filled", fillcolor="#f8fafc", color="#475569"];
  edge  [fontname="Arial", fontsize=8, color="#64748b", arrowsize=0.7];

  push  [label="Push to main", fillcolor="#fff7ed"];
  ver   [label="version job\nrelease-version.mjs\n(commit types since last tag)\nlint + tests"];
  none  [label="No release\n(docs, chore, wip ...)", fillcolor="#f1f5f9"];
  win   [label="build-windows\n.msi (signed update)\n.exe"];
  lin   [label="build-linux\nAppImage + .deb\n(signed updates)"];
  and   [label="build-android\nsigned APK;\ncertificate pin check"];
  rel   [label="release job\npush tag · update-manifest.mjs\n→ latest.json · GitHub Release", fillcolor="#fef3c7", color="#b45309"];

  push -> ver; ver -> none [label="no releasable\ncommit"];
  ver -> win; ver -> lin; ver -> and;
  win -> rel; lin -> rel; and -> rel [label="all must pass"];
}
