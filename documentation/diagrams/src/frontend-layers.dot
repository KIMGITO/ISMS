// Figure 4.2: Staff app layers (src/). Arrows point from a layer to the layer it depends on.
digraph frontend {
  graph [rankdir=TB, fontname="Arial", fontsize=11, nodesep=0.3, ranksep=0.4, pad=0.2];
  node  [fontname="Arial", fontsize=9.5, shape=box, style="rounded,filled", fillcolor="#f8fafc", color="#475569", width=4.6];
  edge  [color="#64748b", arrowsize=0.7];

  shell    [label="App.tsx: shell, authentication screens, navigation, screen routing", fillcolor="#fef3c7", color="#b45309"];
  features [label="features/: one view per screen\n(POSView, QuickSaleView, InventoryView, CustomersView, home/ ...)"];
  comps    [label="components/: shared widgets\n(receipts/, invoices/, loyalty/, GlobalSearch, UpdateBar, MpesaPaymentsPanel ...)"];
  stores   [label="stores/: Zustand state per domain, combined by appStore.ts\n(auth, business, cart, transaction, inventory, customer, notification ...)"];
  services [label="services/: repositories, receipt/, printer/, invoice/, loyalty/,\noffline/salesOutbox, network, realtime, upload/, crashReporter"];
  native   [label="core/native/: platform adapters\n(Bluetooth, camera, files, printer, notifications, updates ...)", width=2.6];
  client   [label="supabaseClient.ts\n(Auth, PostgREST, Realtime, Storage, Functions)", width=2.6];
  utils    [label="utils/: permissions.ts · screens.ts · shortcuts.ts\nsemver · userError · phoneUtils", shape=note, width=2.4, fillcolor="#f1f5f9"];

  shell -> features -> comps -> stores -> services;
  services -> native; services -> client;
  {rank=same; services; utils}
  features -> utils [style=dashed, constraint=false]; stores -> utils [style=dashed, constraint=false];
}
