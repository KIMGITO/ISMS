# Figure 7.2: Staff-initiated M-Pesa prompt for a customer payment.
participant S "Staff app"
participant MP "mpesa-payments"
participant DB "PostgreSQL"
participant D "Safaricom\nDaraja"
participant H "Customer\nhandset"
participant WH "mpesa-webhook"

S -> MP: action "request" (phone, amount, customer)
MP -> MP: requirePermission payments.mpesa;\n60/h per person, 600/day per business
MP -> DB: insert mpesa_transactions (Pending)
MP -> D: STK push (account ref = customer number)
D --> H: PIN prompt
H --> D: PIN entered
D --> WH: callback with ResultCode
WH -> DB: confirm_online_order_payment() (no match)
WH -> DB: confirm_store_payment_request()
note DB: process_business_payment():\ndebt first, then wallet, or walk-in;\nPayment Received notification
divider: if no callback arrives
S -> MP: action "check"
MP -> D: stkpushquery
MP -> DB: confirm_store_payment_request()
