// Offline sales outbox (src/services/offline/salesOutbox.ts, transactionStore.syncOfflineSales).
digraph outbox {
  graph [rankdir=TB, fontname="Arial", fontsize=11, nodesep=0.35, ranksep=0.35, pad=0.2];
  node  [fontname="Arial", fontsize=9, shape=box, style="rounded,filled", fillcolor="#f8fafc", color="#475569"];
  edge  [fontname="Arial", fontsize=8, color="#64748b", arrowsize=0.7];

  a [label="Cashier completes a sale", fillcolor="#fff7ed"];
  b [label="Device online?", shape=diamond, style=filled, fillcolor="white"];
  c [label="Payment is Cash, Card or\nM-Pesa with a typed code?", shape=diamond, style=filled, fillcolor="white"];
  d [label="Refuse: credit sales and live\nM-Pesa prompts need a connection", fillcolor="#fff1f2"];
  e [label="Queue in local storage\nkaykays.offline.sales.v1\nstatus Offline_Pending\n(rose red, 'Waiting to sync')", fillcolor="#fff1f2"];
  f [label="Reconnected or app started", shape=box];
  g [label="record_till_sale()\nper queued sale (oldest first)"];
  h [label="Saved, or duplicate of an\nalready-saved reference?", shape=diamond, style=filled, fillcolor="white"];
  i [label="Remove from queue;\nadd any missing sale lines;\nKRA signing if connected"];
  j [label="Keep in queue\n(refused sales stay; sync stops\nif the network drops)", fillcolor="#fff1f2"];
  k [label="Save immediately\n(status Synced)"];

  a -> b; b -> k [label="yes"]; b -> c [label="no"];
  c -> e [label="yes"]; c -> d [label="no"];
  e -> f -> g -> h; h -> i [label="yes"]; h -> j [label="no"];
}
