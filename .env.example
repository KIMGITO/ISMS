# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_AI_NAME: Custom workspace assistant AI name (e.g., Kim)
VITE_AI_NAME="Kim"

# Supabase Connection Config (For both client and edge functions)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
DATABASE_URL="postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres"
VITE_UNSPLASH_ACCESS_KEY="your-unsplash-access-key"

# Vite client exposed variables (Required for production build exports)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Public website: which business to show (matches businesses.website_slug)
VITE_WEBSITE_SLUG="kaykays"
# The live address, such as https://kaykays.com. While empty, search engines are asked not to index the site.
VITE_SITE_URL=""

# Real Email Delivery SMTP Configuration
# Set these to send emails directly to real inboxes instead of using the Ethereal sandbox fallback.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-password"

# M-Pesa (Daraja) for website checkout. Set these as edge function secrets, never as VITE_ variables:
#   supabase secrets set MPESA_ENV=sandbox MPESA_CONSUMER_KEY=... (and the rest)
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY="your-daraja-consumer-key"
MPESA_CONSUMER_SECRET="your-daraja-consumer-secret"
MPESA_SHORTCODE="your-shortcode"
MPESA_PASSKEY="your-lipa-na-mpesa-passkey"
# KayKay's uses a till in production: CustomerBuyGoodsOnline, MPESA_SHORTCODE is the store number
# Safaricom issues with the passkey, and MPESA_PARTY_B is the till number.
# Daraja's sandbox test shortcode is a paybill, so sandbox uses CustomerPayBillOnline and an empty MPESA_PARTY_B.
MPESA_TRANSACTION_TYPE="CustomerBuyGoodsOnline"
MPESA_PARTY_B="your-till-number"
# A long random string. It authorises Safaricom's callback to the mpesa-webhook function.
MPESA_CALLBACK_TOKEN="generate-a-long-random-string"
