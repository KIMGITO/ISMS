{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Denso",
  "version": "0.1.0",
  "mainBinaryName": "denso",
  "identifier": "com.isms.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npx vite build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Denso",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "img-src": "'self' data: blob: https:",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss://*.supabase.co",
        "frame-src": "'self' blob:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "copyright": "2026 Denso",
    "publisher": "Denso",
    "license": "Proprietary",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/KIMGITO/ISMS",
    "shortDescription": "Business management: sales, stock, money and staff",
    "longDescription": "Denso runs a shop or small chain: point of sale, stock across branches, debts, expenses, payments, workers and reports, with every figure matching the books. Commercial software by Codensons; downloading is free, use needs a paid plan.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "wix": {
        "upgradeCode": "c9a95509-8443-5d55-9b90-92e51ee44ec7"
      }
    },
    "linux": {
      "deb": {
        "section": "misc",
        "files": {
          "/usr/share/metainfo/com.isms.app.metainfo.xml": "linux/com.isms.app.metainfo.xml",
          "/usr/share/doc/denso/copyright": "../LICENSE"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/com.isms.app.metainfo.xml": "linux/com.isms.app.metainfo.xml"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDMzYyRjM0MTIyODc1OEEKUldTS2RTZ1NOQzgyN004WVBUcHpjVStUbW54S0paL0NZNXpWUUI5Mmp5UG5NQ2c0ZUFuOUtLQ3QK",
      "endpoints": [
        "https://raw.githubusercontent.com/KIMGITO/kaykays-releases/update-manifest/latest.json",
        "https://cdn.jsdelivr.net/gh/KIMGITO/kaykays-releases@update-manifest/latest.json",
        "https://github.com/KIMGITO/kaykays-releases/releases/latest/download/latest.json",
        "https://raw.githubusercontent.com/KIMGITO/ISMS/update-manifest/latest.json",
        "https://github.com/KIMGITO/ISMS/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
